{
  "name": "gate",
  "description": "HTTP/WS edge proxy (NATS public routes)",
  "order": 10,
  "env": {
    "HTTP_ADDR": ":8080",
    "WS_ALLOWED_ORIGINS": "*",
    "CORS_ALLOWED_ORIGINS": "*",
    "RATE_LIMIT_RPS": "100",
    "RATE_LIMIT_BURST": "200",
    "MAX_IN_FLIGHT": "0",
    "GATE_DISCOVER_INTERVAL": "5s",
    "GATE_REQUEST_TIMEOUT": "30s"
  }
}