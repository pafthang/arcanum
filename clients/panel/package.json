{
  "name": "@arcanum/panel",
	"private": true,
	"version": "0.1.16",
	"type": "module",
	"scripts": {
		"arc:dev": "vite dev",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie baseLocale --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "bun test tests/unit",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"paneforge": "^1.0.2",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@arcanum/ts-client": "workspace:*",
		"@vincjo/datatables": "^2.8.1",
		"echarts": "^6.1.0"
	},
	"overrides": {
		"cookie": "2.0.1"
	}
}
