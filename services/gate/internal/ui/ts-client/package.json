{
  "name": "@arcanum/ts-client",
  "version": "0.1.0",
  "description": "TypeScript client for Arcanum Svelte 5 + runes",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.5.3"
  }
}
